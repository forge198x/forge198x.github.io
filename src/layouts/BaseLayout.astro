---
import '@198x-ui/tokens.css';
import '@198x-ui/fonts.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Forge198x',
  description = "The workbench where 198x code gets written. Forge198x will be the family's development environment \u2014 editor, assembler, emulator and debugger in one place",
} = Astro.props;

const pageTitle = title === 'Forge198x' ? title : `${title} - Forge198x`;
---

<!doctype html>
<!-- data-tint carries the project colour as an ambient ground, at the ceilings
     fixed in the kit's tokens.css. See family-visual-identity.md §3b. -->
<html lang="en" data-tint="forge">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <slot />
  </body>
</html>
